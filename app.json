{
  "expo": {
    "name": "Lango",
    "slug": "lango",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lango",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D0D12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lango.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Lango uses speech recognition for pronunciation practice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D12"
      },
      "package": "com.lango.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/lango"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C63FF"
        }
      ]
    ],
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyBvZX7cz-K0YstNlyM5VQistrzzcrsmm_c",
        "authDomain": "lango-mob-app.firebaseapp.com",
        "projectId": "lango-mob-app",
        "storageBucket": "lango-mob-app.firebasestorage.app",
        "messagingSenderId": "687507164865",
        "appId": "1:687507164865:web:7f7797aeb50aa9521f0e40",
        "measurementId": "G-YDVBQ56JVW"
      }
    }
  }
}
