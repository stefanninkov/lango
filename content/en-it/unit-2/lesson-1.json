  "grammar": {
    "title": "Numbers in Italian",
    "explanation": "Italian numbers follow a regular pattern. From 1-10, each number is unique. For 11-19, they combine with 'dici'. From 20 onwards, tens are combined with units. 'Avere' (to have) is used for age: 'Ho venti anni' (I have twenty years).",
    "examples": [
      { "target": "Ho ventuno anni.", "native": "I am twenty-one years old." },
      { "target": "Sono le tre.", "native": "It is three o'clock." },
      { "target": "Quanti anni hai?", "native": "How old are you?" }
    ]
  },
