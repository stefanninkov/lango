  "grammar": {
    "title": "Articles with Food",
    "explanation": "Italian uses definite articles (il, la, l') before food nouns. 'Il' is for masculine nouns, 'la' for feminine, and 'l'' before vowels. Use 'vorrei' (I would like) for polite ordering. 'Mi piace' means 'I like' (literally 'it pleases me').",
    "examples": [
      { "target": "Vorrei il conto, per favore.", "native": "I would like the check, please." },
      { "target": "Mi piace il gelato.", "native": "I like ice cream." },
      { "target": "Non mi piace il vino.", "native": "I don't like wine." }
    ]
  },
