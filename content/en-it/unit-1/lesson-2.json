  "grammar": {
    "title": "Introducing Yourself with 'Chiamarsi'",
    "explanation": "In Italian, to say your name you use the reflexive verb 'chiamarsi' (to call oneself). 'Mi chiamo' literally means 'I call myself'. To ask someone's name informally, say 'Come ti chiami?'. In formal situations, use 'Come si chiama?'. The verb 'essere' (to be) is also common: 'Sono Maria' means 'I am Maria'.",
    "examples": [
      { "target": "Mi chiamo Anna.", "native": "My name is Anna." },
      { "target": "Come ti chiami?", "native": "What is your name? (informal)" },
      { "target": "Come si chiama?", "native": "What is your name? (formal)" },
      { "target": "Sono italiano.", "native": "I am Italian." }
    ]
  },
