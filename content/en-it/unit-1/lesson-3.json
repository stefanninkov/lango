  "grammar": {
    "title": "Polite Requests and Formal Address",
    "explanation": "Italian uses 'Lei' (the formal 'you') when speaking to strangers, elders, or in professional settings. Verbs change accordingly: 'scusa' (informal) becomes 'scusi' (formal), and 'parli' becomes 'parla'. Adding 'per favore' (please) makes any request more polite. 'Prego' is versatile: it means 'you're welcome', 'please go ahead', or 'may I help you'.",
    "examples": [
      { "target": "Scusa, puoi aiutarmi?", "native": "Excuse me, can you help me? (informal)" },
      { "target": "Scusi, può aiutarmi?", "native": "Excuse me, can you help me? (formal)" },
      { "target": "Un bicchiere d'acqua, per favore.", "native": "A glass of water, please." }
    ]
  },
