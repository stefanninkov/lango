  "grammar": {
    "title": "Formal vs. Informal Greetings",
    "explanation": "Italian distinguishes between formal and informal speech. Use 'ciao' with friends and family, and 'buongiorno', 'buonasera', or 'arrivederci' in formal settings or with strangers. 'Salve' is a safe middle ground when you are unsure which register to use.",
    "examples": [
      { "target": "Ciao, come stai?", "native": "Hi, how are you? (informal)" },
      { "target": "Buongiorno, come sta?", "native": "Good day, how are you? (formal)" },
      { "target": "Salve, tutto bene?", "native": "Hello, all good? (neutral)" }
    ]
  },
