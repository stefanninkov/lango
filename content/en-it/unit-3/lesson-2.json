  "grammar": {
    "title": "Adjective Agreement in Italian",
    "explanation": "Italian adjectives must agree in gender and number with the noun they describe. Most adjectives ending in -o change to -a for feminine singular, -i for masculine plural, and -e for feminine plural (alto/alta/alti/alte). Adjectives ending in -e (like intelligente, gentile, forte) have the same form for both masculine and feminine singular, and change to -i in the plural (intelligenti, gentili, forti).",
    "examples": [
      { "target": "Il ragazzo è alto. La ragazza è alta.", "native": "The boy is tall. The girl is tall." },
      { "target": "Lui è intelligente. Lei è intelligente.", "native": "He is intelligent. She is intelligent." },
      { "target": "I ragazzi sono forti. Le ragazze sono forti.", "native": "The boys are strong. The girls are strong." }
    ]
  },
