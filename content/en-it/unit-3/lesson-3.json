  "grammar": {
    "title": "Definite Articles with Occupations",
    "explanation": "In Italian, when stating someone's occupation with the verb 'essere' (to be), you typically omit the article: 'Sono medico' (I am a doctor). However, when describing someone else with a modified noun, the article is used: 'Il medico è bravo' (The doctor is good). Some occupation nouns change for gender: professore/professoressa, infermiere/infermiera, cuoco/cuoca. Others remain the same for both genders: ingegnere, studente.",
    "examples": [
      { "target": "Sono avvocato.", "native": "I am a lawyer." },
      { "target": "Maria è professoressa.", "native": "Maria is a professor." },
      { "target": "Il cuoco lavora nel ristorante.", "native": "The chef works in the restaurant." }
    ]
  },
