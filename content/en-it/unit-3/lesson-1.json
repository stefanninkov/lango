  "grammar": {
    "title": "Possessive Adjectives with Family Members",
    "explanation": "In Italian, possessive adjectives (mio, tuo, suo, etc.) agree in gender and number with the noun they modify. With singular family members, the definite article is usually dropped: 'mia madre' (my mother), NOT 'la mia madre'. However, with plural family members or modified nouns, the article is kept: 'le mie sorelle' (my sisters), 'la mia cara madre' (my dear mother).",
    "examples": [
      { "target": "Mio fratello è alto.", "native": "My brother is tall." },
      { "target": "Sua sorella lavora a Roma.", "native": "His/Her sister works in Rome." },
      { "target": "I miei nonni vivono in campagna.", "native": "My grandparents live in the countryside." }
    ]
  },
