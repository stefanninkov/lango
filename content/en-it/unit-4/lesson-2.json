  "grammar": {
    "title": "The Conditional Tense (Condizionale Presente)",
    "explanation": "The conditional tense in Italian is used for polite requests, especially in restaurants. It is formed by adding endings to the infinitive stem: -ei, -esti, -ebbe, -emmo, -este, -ebbero. For -are verbs, the 'a' changes to 'e': mangiare -> mangerei. Common examples: 'vorrei' (I would like), 'prenderemmo' (we would take). The conditional makes requests sound more courteous than the present tense.",
    "examples": [
      { "target": "Vorrei un caffè, per favore.", "native": "I would like a coffee, please." },
      { "target": "Prenderemmo il piatto del giorno.", "native": "We would take the dish of the day." },
      { "target": "Potrebbe portare il menù?", "native": "Could you bring the menu?" }
    ]
  },
