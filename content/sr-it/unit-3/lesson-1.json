  "grammar": {
    "title": "Prisvojni pridevi u italijanskom",
    "explanation": "U italijanskom jeziku prisvojni pridevi se slažu u rodu i broju sa imenicom koju opisuju, a ne sa vlasnikom. Na primer: 'mio padre' (moj otac), 'mia madre' (moja majka). Ispred prisvojnih prideva obično stoji određeni član (il, la, i, le), ali se kod članova uže porodice u jednini član izostavlja: 'mio padre', ali 'il mio amico'.",
    "examples": [
      { "target": "Mia madre è italiana.", "native": "Moja majka je Italijanka." },
      { "target": "Mio fratello ha vent'anni.", "native": "Moj brat ima dvadeset godina." },
      { "target": "I miei nonni vivono a Roma.", "native": "Moji deda i baka žive u Rimu." },
      { "target": "La mia sorella maggiore lavora.", "native": "Moja starija sestra radi." }
    ]
  },
