  "grammar": {
    "title": "Imenice za zanimanja – muški i ženski rod",
    "explanation": "U italijanskom jeziku mnoga zanimanja imaju muški i ženski oblik. Imenice na '-ore' (professore) u ženskom rodu postaju '-oressa' (professoressa). Imenice na '-iere' (infermiere) postaju '-iera' (infermiera). Neka zanimanja kao 'medico' i 'avvocato' tradicionalno koriste muški oblik, ali sve češće se koriste i oblici 'medica' i 'avvocata'. Član ispred imenice takođe ukazuje na rod: 'il medico' / 'la medica'.",
    "examples": [
      { "target": "Il professore è bravo.", "native": "Profesor je dobar." },
      { "target": "La professoressa è brava.", "native": "Profesorka je dobra." },
      { "target": "L'infermiere lavora di notte.", "native": "Medicinski tehničar radi noću." },
      { "target": "L'infermiera lavora di giorno.", "native": "Medicinska sestra radi danju." }
    ]
  },
