  "grammar": {
    "title": "Glagol 'essere' (biti) u prvom licu i predstavljanje",
    "explanation": "Za predstavljanje u italijanskom koristite 'Mi chiamo...' (Zovem se...) ili 'Sono...' (Ja sam...). Glagol 'essere' (biti) u prvom licu jednine glasi 'sono'. Kada govorite odakle ste, koristite konstrukciju 'Sono di + grad/zemlja'. Na primer: 'Sono di Belgrado' (Ja sam iz Beograda). Za pitanje odakle je neko, koristite 'Di dove sei?' (neformalno) ili 'Di dov'è?' (formalno).",
    "examples": [
      { "target": "Mi chiamo Anna.", "native": "Zovem se Ana." },
      { "target": "Sono di Milano.", "native": "Ja sam iz Milana." },
      { "target": "Sono serbo.", "native": "Ja sam Srbin." },
      { "target": "Di dove sei?", "native": "Odakle si?" }
    ]
  },
