  "grammar": {
    "title": "Formalno i neformalno obraćanje",
    "explanation": "U italijanskom jeziku postoje dva nivoa obraćanja. 'Ciao' se koristi u neformalnim situacijama, sa prijateljima i porodicom. 'Buongiorno' i 'Buonasera' su formalniji i koriste se sa nepoznatim osobama, na poslu ili u zvaničnim prilikama. 'Come stai?' je neformalno pitanje ('ti' forma), dok je 'Come sta?' formalna verzija ('Lei' forma).",
    "examples": [
      { "target": "Ciao, come stai?", "native": "Zdravo, kako si? (neformalno)" },
      { "target": "Buongiorno, come sta?", "native": "Dobar dan, kako ste? (formalno)" },
      { "target": "Arrivederci, signore.", "native": "Doviđenja, gospodine. (formalno)" },
      { "target": "Ciao, a presto!", "native": "Ćao, vidimo se uskoro! (neformalno)" }
    ]
  },
