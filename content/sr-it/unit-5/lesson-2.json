  "grammar": {
    "title": "Imperativ – davanje uputstava",
    "explanation": "U italijanskom jeziku imperativ se koristi za davanje uputstava i pravaca. Za neformalno obraćanje (tu), glagoli na '-are' dobijaju nastavak '-a' (gira = skreni), glagoli na '-ere' dobijaju '-i' (prendi = uzmi), a glagoli na '-ire' dobijaju '-i' (segui = prati). Za formalno obraćanje (Lei), koristi se konjunktiv: 'giri' (skrenite), 'prenda' (uzmite). Negativni imperativ za 'tu' formu koristi 'non' + infinitiv: 'non girare' (ne skreći).",
    "examples": [
      { "target": "Gira a sinistra.", "native": "Skreni levo." },
      { "target": "Vai dritto.", "native": "Idi pravo." },
      { "target": "Attraversa la strada.", "native": "Pređi ulicu." },
      { "target": "Non girare a destra.", "native": "Ne skreći desno." }
    ]
  },
