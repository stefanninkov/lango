  "grammar": {
    "title": "Bezlični izrazi za vreme – 'fa' i 'c'è'",
    "explanation": "U italijanskom jeziku za opisivanje vremena koriste se bezlični izrazi sa glagolom 'fare': 'fa caldo' (vruće je), 'fa freddo' (hladno je). Za prirodne pojave koristi se 'c'è' (ima): 'c'è il sole' (ima sunca), 'c'è vento' (ima vetra). Za kišu i sneg koristi se glagol kao subjekat: 'piove' (pada kiša), 'nevica' (pada sneg). Godišnja doba idu sa predlogom 'in': 'in primavera' (u proleće), 'in inverno' (zimi).",
    "examples": [
      { "target": "Oggi fa caldo.", "native": "Danas je vruće." },
      { "target": "C'è il sole.", "native": "Ima sunca." },
      { "target": "In inverno fa freddo.", "native": "Zimi je hladno." },
      { "target": "Piove molto in autunno.", "native": "Mnogo pada kiša u jesen." }
    ]
  },
