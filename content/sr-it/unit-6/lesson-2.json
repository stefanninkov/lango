  "grammar": {
    "title": "Povratni glagoli u italijanskom",
    "explanation": "Povratni glagoli (verbi riflessivi) u italijanskom koriste povratne zamenice: mi, ti, si, ci, vi, si. U infinitivu se završavaju na '-rsi': svegliarsi, vestirsi, alzarsi. Kada se konjuguju, povratna zamenica dolazi ispred glagola: 'mi sveglio' (budim se), 'ti vesti' (oblačiš se). U perfektu (passato prossimo) povratni glagoli koriste pomoćni glagol 'essere': 'mi sono svegliato/a' (probudio/la sam se).",
    "examples": [
      { "target": "Mi sveglio alle sette.", "native": "Budim se u sedam." },
      { "target": "Ti vesti rapidamente.", "native": "Oblačiš se brzo." },
      { "target": "Si alza presto.", "native": "Ustaje rano." },
      { "target": "Ci riposiamo il weekend.", "native": "Odmaramo se vikendom." }
    ]
  },
