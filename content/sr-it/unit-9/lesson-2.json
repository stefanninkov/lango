  "grammar": {
    "title": "Konjunktiv (congiuntivo) posle glagola mišljenja",
    "explanation": "U italijanskom jeziku posle glagola koji izražavaju mišljenje, verovanje ili sumnju koristi se konjunktiv (congiuntivo). 'Penso che sia...' (Mislim da je...), 'Credo che abbia...' (Verujem da ima...). Konjunktiv prezenta se razlikuje od indikativa: 'è' → 'sia', 'ha' → 'abbia'. Veznik 'che' (da) uvodi zavisnu rečenicu sa konjunktivom. Veznici 'sebbene' (iako) i 'affinché' (da bi) takođe zahtevaju konjunktiv.",
    "examples": [
      { "target": "Penso che sia giusto.", "native": "Mislim da je ispravno." },
      { "target": "Credo che abbia ragione.", "native": "Verujem da je u pravu." },
      { "target": "Sebbene sia difficile, è possibile.", "native": "Iako je teško, moguće je." },
      { "target": "Non credo che sia vero.", "native": "Ne verujem da je istina." }
    ]
  },
