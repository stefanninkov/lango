  "grammar": {
    "title": "Formalno obraćanje kod lekara – 'Lei' forma",
    "explanation": "U medicinskom kontekstu u Italiji koristi se formalna 'Lei' forma. Lekar se obraća pacijentu sa 'Lei': 'Come si sente?' (Kako se osećate?), 'Ha qualche allergia?' (Imate li neku alergiju?). Pacijent se obraća lekaru sa 'Lei' i titulom 'Dottore/Dottoressa': 'Dottore, ho mal di testa' (Doktore, imam glavobolju). Prisvojni pridev je 'Suo/Sua': 'I Suoi sintomi' (Vaši simptomi).",
    "examples": [
      { "target": "Come si sente oggi?", "native": "Kako se osećate danas?" },
      { "target": "Ha qualche allergia?", "native": "Imate li neku alergiju?" },
      { "target": "Le prescrivo una medicina.", "native": "Prepisujem Vam lek." },
      { "target": "Dottore, ho un forte dolore.", "native": "Doktore, imam jak bol." }
    ]
  },
