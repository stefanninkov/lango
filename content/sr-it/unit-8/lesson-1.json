  "grammar": {
    "title": "Izražavanje bola i simptoma – 'avere' i 'fare male'",
    "explanation": "U italijanskom jeziku za izražavanje zdravstvenih tegoba koriste se dva glavna izraza. 'Avere' (imati) + imenica: 'Ho la febbre' (Imam temperaturu), 'Ho la tosse' (Imam kašalj), 'Ho mal di testa' (Imam glavobolju). 'Fare male' (boleti): 'Mi fa male la testa' (Boli me glava), gde 'mi' označava koga boli. Za množinu: 'Mi fanno male le gambe' (Bole me noge).",
    "examples": [
      { "target": "Ho mal di testa.", "native": "Imam glavobolju." },
      { "target": "Mi fa male lo stomaco.", "native": "Boli me stomak." },
      { "target": "Ho la febbre e la tosse.", "native": "Imam temperaturu i kašalj." },
      { "target": "Mi fanno male le gambe.", "native": "Bole me noge." }
    ]
  },
