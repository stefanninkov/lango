  "grammar": {
    "title": "Poređenje prideva - más/menos",
    "explanation": "Za poređenje u španskom koristimo:\n\n• más + pridev + que: más caro que (skuplje od)\n• menos + pridev + que: menos barato que (manje jeftino od)\n• tan + pridev + como: tan grande como (isto tako veliko kao)\n\nNepravilna poređenja:\n• bueno → mejor (bolji)\n• malo → peor (gori)\n• grande → mayor (veći)\n• pequeño → menor (manji)",
    "examples": [
      { "target": "Esta camisa es más cara que esa.", "native": "Ova košulja je skuplja od one." },
      { "target": "Los zapatos son menos caros aquí.", "native": "Cipele su manje skupe ovde." },
      { "target": "Esta tienda es mejor que la otra.", "native": "Ova prodavnica je bolja od one druge." }
    ]
  },
