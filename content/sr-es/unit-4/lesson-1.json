  "grammar": {
    "title": "Članovi u španskom - el, la, los, las",
    "explanation": "U španskom imenice imaju rod (muški ili ženski) i koriste određeni član:\n\n• el - muški rod jednina: el pan (hleb), el arroz (pirinač)\n• la - ženski rod jednina: la carne (meso), la fruta (voće)\n• los - muški rod množina: los pescados (ribe)\n• las - ženski rod množina: las verduras (povrće)\n\nIzuzetak: 'el agua' - iako je 'agua' ženskog roda, koristi 'el' jer počinje naglašenim 'a'.",
    "examples": [
      { "target": "El pan está en la mesa.", "native": "Hleb je na stolu." },
      { "target": "La carne es cara.", "native": "Meso je skupo." },
      { "target": "Las frutas son deliciosas.", "native": "Voće je ukusno." }
    ]
  },
