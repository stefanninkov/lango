  "grammar": {
    "title": "Izražavanje bola - 'Me duele / Me duelen'",
    "explanation": "Za izražavanje bola u španskom koristimo glagol 'doler' (boleti) sa indirektnom zamenicom:\n\n• Me duele + jednina: Me duele la cabeza (Boli me glava)\n• Me duelen + množina: Me duelen los ojos (Bole me oči)\n\nZamenice po licima:\n• me duele (mene boli), te duele (tebe boli), le duele (njega/nju boli)\n• nos duele (nas boli), les duele (njih boli)\n\nTakođe: 'Tengo dolor de...' (Imam bol u...): Tengo dolor de estómago.",
    "examples": [
      { "target": "Me duele mucho la cabeza.", "native": "Mnogo me boli glava." },
      { "target": "¿Te duele el estómago?", "native": "Da li te boli stomak?" },
      { "target": "Tengo dolor de garganta y tos.", "native": "Imam bol u grlu i kašalj." }
    ]
  },
