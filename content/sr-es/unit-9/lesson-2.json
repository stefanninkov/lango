  "grammar": {
    "title": "Veznici za izražavanje mišljenja i argumentacije",
    "explanation": "Za strukturiranje argumenata u španskom koristimo veznike:\n\n• Za dodavanje: además (osim toga), también (takođe)\n• Za kontrast: sin embargo (međutim), aunque (iako), en cambio (s druge strane)\n• Za zaključak: por lo tanto (prema tome), en conclusión (u zaključku)\n• Za mišljenje: creo que (verujem da), opino que (mislim da), en mi opinión (po mom mišljenju)\n\nNakon 'creo que' koristimo indikativ: 'Creo que es interesante.'\nNakon 'no creo que' koristimo subjunktiv: 'No creo que sea interesante.'",
    "examples": [
      { "target": "Creo que es una buena idea.", "native": "Verujem da je to dobra ideja." },
      { "target": "No estoy de acuerdo; sin embargo, respeto tu opinión.", "native": "Ne slažem se; međutim, poštujem tvoje mišljenje." },
      { "target": "Aunque es difícil, es posible.", "native": "Iako je teško, moguće je." }
    ]
  },
