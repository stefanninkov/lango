  "grammar": {
    "title": "Color Adjective Agreement",
    "explanation": "In Spanish, color adjectives must agree in gender and number with the noun they describe.\n\n• Colors ending in -o change to -a for feminine nouns: 'rojo' → 'roja', 'blanco' → 'blanca'.\n• Colors ending in -e or a consonant (verde, azul, naranja) stay the same for both genders.\n• All colors add -s (or -es for consonant endings) for plural: 'rojos', 'azules'.\n\nColors are placed after the noun: 'la casa blanca' (the white house).",
    "examples": [
      { "target": "El libro rojo", "native": "The red book (masculine)" },
      { "target": "La camisa roja", "native": "The red shirt (feminine)" },
      { "target": "Los zapatos azules", "native": "The blue shoes (plural)" }
    ]
  },
