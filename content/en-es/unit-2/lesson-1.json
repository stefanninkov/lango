  "grammar": {
    "title": "Spanish Numbers and Counting",
    "explanation": "Spanish numbers 1-15 each have a unique name that must be memorized. From 16-19, numbers are formed by combining 'dieci-' with the ones digit (e.g., dieciséis = 16). Twenty is 'veinte', and 21-29 follow the pattern 'veinti-' plus the ones digit (e.g., veintiuno = 21).\n\nNote: 'uno' becomes 'un' before masculine nouns ('un libro' = a/one book) and 'una' before feminine nouns ('una mesa' = a/one table).",
    "examples": [
      { "target": "Tengo un hermano.", "native": "I have one brother." },
      { "target": "Hay dieciséis sillas.", "native": "There are sixteen chairs." },
      { "target": "Necesito veintiún libros.", "native": "I need twenty-one books." }
    ]
  },
