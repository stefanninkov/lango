  "grammar": {
    "title": "Days and Months in Spanish",
    "explanation": "Important rules for days and months in Spanish:\n\n• Days of the week and months are NOT capitalized in Spanish (unlike English): 'lunes', 'enero'.\n• Use 'el' before a day to mean 'on': 'el lunes' = on Monday.\n• Use 'los' for recurring events: 'los lunes' = on Mondays (every Monday).\n• Use 'en' before months: 'en enero' = in January.\n• The week starts on Monday (lunes) in Spanish-speaking countries.",
    "examples": [
      { "target": "Trabajo el martes.", "native": "I work on Tuesday." },
      { "target": "Estudio los viernes.", "native": "I study on Fridays." },
      { "target": "Viajo en agosto.", "native": "I travel in August." }
    ]
  },
