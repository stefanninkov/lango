  "grammar": {
    "title": "The Verb 'Ser' (To Be) — Basic Forms",
    "explanation": "The verb 'ser' is one of the most important verbs in Spanish. It means 'to be' and is used for identity, origin, and characteristics.\n\n• Yo soy — I am\n• Tú eres — You are (informal)\n• Él/Ella es — He/She is\n\nFor introductions, you'll mostly use 'soy' (I am) and 'eres' (you are).",
    "examples": [
      { "target": "Yo soy Carlos.", "native": "I am Carlos." },
      { "target": "¿Tú eres María?", "native": "Are you María?" },
      { "target": "Él es mi amigo.", "native": "He is my friend." }
    ]
  },
