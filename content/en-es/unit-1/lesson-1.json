  "grammar": {
    "title": "Formal vs Informal Greetings",
    "explanation": "In Spanish, there are two ways to address people:\n\n• Informal (tú): Used with friends, family, and people your age.\n• Formal (usted): Used with strangers, elders, and in professional settings.\n\nThis affects the verb form: '¿Cómo estás?' (informal) vs '¿Cómo está usted?' (formal).",
    "examples": [
      { "target": "¿Cómo estás?", "native": "How are you? (informal)" },
      { "target": "¿Cómo está usted?", "native": "How are you? (formal)" },
      { "target": "Hola, ¿qué tal?", "native": "Hi, what's up? (very informal)" }
    ]
  },
