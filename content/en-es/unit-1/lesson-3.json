  "grammar": {
    "title": "Saying Please and Thank You",
    "explanation": "Spanish speakers value politeness. Here are key patterns:\n\n• 'Por favor' goes at the end or beginning of a request\n• 'Muchas gracias' = 'Thank you very much'\n• 'Perdón' is for minor interruptions; 'Lo siento' is for apologies\n• 'Disculpe' (formal) vs 'Disculpa' (informal) for getting attention",
    "examples": [
      { "target": "Un agua, por favor.", "native": "A water, please." },
      { "target": "Muchas gracias.", "native": "Thank you very much." },
      { "target": "Disculpa, ¿tienes hora?", "native": "Excuse me, do you have the time? (informal)" }
    ]
  },
