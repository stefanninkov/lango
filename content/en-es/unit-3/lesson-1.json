  "grammar": {
    "title": "Possessive Adjectives",
    "explanation": "In Spanish, possessive adjectives indicate who owns or is related to something. They must agree in number (and sometimes gender) with the noun they modify:\n\n• mi/mis - my\n• tu/tus - your (informal)\n• su/sus - his/her/your (formal)/their\n• nuestro/nuestra/nuestros/nuestras - our\n\nNote: 'mi', 'tu', and 'su' do not change for gender, only for number. 'Nuestro' changes for both gender and number.",
    "examples": [
      { "target": "Mi madre es profesora.", "native": "My mother is a teacher." },
      { "target": "Nuestros abuelos viven en España.", "native": "Our grandparents live in Spain." },
      { "target": "Sus hijos son muy amables.", "native": "Their children are very kind." }
    ]
  },
